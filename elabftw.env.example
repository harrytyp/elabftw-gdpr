# eLabFTW access credentials - template.
# Copy to:  cp elabftw.env.example elabftw.env
# Fill in the values and protect the file:  chmod 600 elabftw.env
# IMPORTANT: elabftw.env is gitignored - never commit or share it!

# --- Pipeline A (API): required for elab-gdpr ---
ELAB_URL=https://eln.example.org
ELAB_KEY=your-sysadmin-api-key

# --- Optional: default user ID(s) for scripting (no prompt) ---
# If omitted, elab-gdpr asks interactively (lists users from the instance).
#ELAB_USERID=42

# --- Pipeline B (DB): NOT required on the eLabFTW server ---
# elab-gdpr-db auto-detects the MySQL container, compose/.env file and DB
# name, and reads the credentials from the stack's .env itself. The flags
# below override that detection when several candidates exist:
#   --db-container <name>   MySQL/MariaDB container (docker ps)
#   --db-env-file <path>    compose or .env file with ELABFTW_DB_PASSWORD
#   --db-name <name>        database name (default: auto-detect)
# ELAB_DB_* variables are NOT used - the detection prefers the stack .env.
